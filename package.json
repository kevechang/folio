{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "package:app": "node scripts/package-app.mjs",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "dev:web": "vite"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "dompurify": "3.4.16",
    "echarts": "6.1.0",
    "fractional-indexing": "3.2.0",
    "idb-keyval": "^6.2.2",
    "katex": "0.18.9",
    "lucide-react": "^1.47.0",
    "mermaid": "12.0.0",
    "motion": "^13.0.0",
    "penna-markdown": "0.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "main": "out/main/index.js",
  "license": "GPL-3.0-or-later",
  "description": "A macOS reader and editor for Excalidraw canvases and Markdown, in one library.",
  "author": "Keve Chang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevechang/folio.git"
  },
  "homepage": "https://github.com/kevechang/folio",
  "bugs": {
    "url": "https://github.com/kevechang/folio/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
